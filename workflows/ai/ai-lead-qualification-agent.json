{
  "name": "AI Lead Qualification Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qualify-lead",
        "options": {
          "rawBody": false
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook - Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 300],
      "webhookId": "qualify-lead-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate and normalise inbound lead payload.\n// Expected fields: name, email, company, role, message (all from a form).\nconst body = $json.body || $json;\n\nconst name = body.name || 'Unknown';\nconst email = body.email || '';\nconst company = body.company || 'Unknown';\nconst role = body.role || 'Unknown';\nconst message = body.message || '';\n\nif (!email) throw new Error('Lead is missing an email address — cannot qualify.');\n\nconst qualificationPrompt = `You are a B2B sales qualification expert. Score the following inbound lead from 0-100 based on:\n- Seniority (Director/VP/C-Suite = high)\n- Company size signals (enterprise keywords = high)\n- Intent signals in their message (specific problem, urgency = high)\n- Red flags (student, competitor, vague = low)\n\nLead Info:\nName: ${name}\nCompany: ${company}\nRole: ${role}\nMessage: ${message}\n\nRespond with ONLY valid JSON:\n{\n  \"score\": <0-100>,\n  \"tier\": \"hot\" | \"warm\" | \"cold\",\n  \"reasoning\": \"<one sentence>\",\n  \"suggested_action\": \"<one sentence>\"\n}`;\n\nreturn [{ json: { name, email, company, role, message, qualificationPrompt } }];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Parse & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "claude-haiku-4-5-20251001",
          "max_tokens": 300,
          "messages": [
            {
              "role": "user",
              "content": "={{ $json.qualificationPrompt }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Claude API - Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Claude returns content[0].text — parse the JSON from it.\nconst rawText = $json.content?.[0]?.text || '{}';\nlet qualification;\ntry {\n  qualification = JSON.parse(rawText);\n} catch (e) {\n  // Fallback if Claude added extra text around the JSON\n  const match = rawText.match(/\\{[\\s\\S]+\\}/);\n  qualification = match ? JSON.parse(match[0]) : { score: 0, tier: 'cold', reasoning: 'Parse error', suggested_action: 'Review manually' };\n}\n\nconst lead = $('Parse & Build Prompt').first().json;\n\nreturn [{\n  json: {\n    ...lead,\n    score: qualification.score,\n    tier: qualification.tier,\n    reasoning: qualification.reasoning,\n    suggested_action: qualification.suggested_action\n  }\n}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Extract Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-score-hot",
              "leftValue": "={{ $json.tier }}",
              "rightValue": "hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "IF - Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "REPLACE_WITH_YOUR_AIRTABLE_BASE_ID",
        "tableId": "Leads",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Role": "={{ $json.role }}",
            "Score": "={{ $json.score }}",
            "Tier": "={{ $json.tier }}",
            "Reasoning": "={{ $json.reasoning }}",
            "Suggested Action": "={{ $json.suggested_action }}",
            "Status": "New",
            "Created At": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Airtable - Save Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1250, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_HOT_LEADS_CHANNEL_ID",
          "mode": "id"
        },
        "text": "🔥 *HOT LEAD — Score: {{ $json.score }}/100*\n\n*Name:* {{ $json.name }}\n*Company:* {{ $json.company }}\n*Role:* {{ $json.role }}\n*Email:* {{ $json.email }}\n\n*AI Reasoning:* {{ $json.reasoning }}\n*Suggested Action:* {{ $json.suggested_action }}",
        "otherOptions": {
          "unfurl_links": false
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Slack - Alert Hot Lead",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1500, 200],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "REPLACE_WITH_YOUR_AIRTABLE_BASE_ID",
        "tableId": "Leads",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Role": "={{ $json.role }}",
            "Score": "={{ $json.score }}",
            "Tier": "={{ $json.tier }}",
            "Reasoning": "={{ $json.reasoning }}",
            "Suggested Action": "={{ $json.suggested_action }}",
            "Status": "New",
            "Created At": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "Airtable - Log Warm/Cold Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1250, 400],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    }
  ],
  "connections": {
    "Webhook - Receive Lead": {
      "main": [[{ "node": "Parse & Build Prompt", "type": "main", "index": 0 }]]
    },
    "Parse & Build Prompt": {
      "main": [[{ "node": "Claude API - Score Lead", "type": "main", "index": 0 }]]
    },
    "Claude API - Score Lead": {
      "main": [[{ "node": "Extract Score", "type": "main", "index": 0 }]]
    },
    "Extract Score": {
      "main": [[{ "node": "IF - Hot Lead?", "type": "main", "index": 0 }]]
    },
    "IF - Hot Lead?": {
      "main": [
        [{ "node": "Airtable - Save Lead", "type": "main", "index": 0 }],
        [{ "node": "Airtable - Log Warm/Cold Lead", "type": "main", "index": 0 }]
      ]
    },
    "Airtable - Save Lead": {
      "main": [[{ "node": "Slack - Alert Hot Lead", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "id": "wf-ai-lead-qualification-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "n8n-workflow-library"
  },
  "tags": [{ "name": "ai" }, { "name": "crm" }, { "name": "claude" }, { "name": "lead-gen" }]
}
