{
  "name": "AI Email Draft Generator",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyFiveMinutes" }]
        },
        "filters": {
          "labelIds": ["INBOX", "UNREAD"]
        },
        "options": {
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract what we need from the raw Gmail trigger output.\n// $json contains the full Gmail message object.\nconst subject = $json.subject || '(no subject)';\nconst from = $json.from?.value?.[0]?.address || $json.from || 'Unknown Sender';\nconst body = $json.text || $json.snippet || '';\n\n// Build a prompt that tells the LLM its role and what to write.\nconst prompt = `You are a professional email assistant. Draft a concise, warm, and professional reply to the email below.\n\nEmail From: ${from}\nSubject: ${subject}\n\nEmail Body:\n${body}\n\n---\nWrite only the reply body. Do not include a subject line. Be helpful, professional, and match the tone of the original email.`;\n\nreturn [{ json: { prompt, subject, from, originalBody: body } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "gpt-4o-mini",
          "messages": [
            {
              "role": "system",
              "content": "You are a professional email assistant."
            },
            {
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ],
          "temperature": 0.7,
          "max_tokens": 500
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "OpenAI - Generate Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// OpenAI returns choices[0].message.content — pull it out cleanly.\nconst aiReply = $json.choices?.[0]?.message?.content || 'Could not generate draft.';\nconst prevData = $('Build Prompt').first().json;\n\nreturn [{\n  json: {\n    draftBody: aiReply,\n    subject: 'Re: ' + prevData.subject,\n    toEmail: prevData.from\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Extract AI Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.draftBody }}",
        "toList": "={{ $json.toEmail }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Save as Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1000, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [[{ "node": "Build Prompt", "type": "main", "index": 0 }]]
    },
    "Build Prompt": {
      "main": [[{ "node": "OpenAI - Generate Draft", "type": "main", "index": 0 }]]
    },
    "OpenAI - Generate Draft": {
      "main": [[{ "node": "Extract AI Reply", "type": "main", "index": 0 }]]
    },
    "Extract AI Reply": {
      "main": [[{ "node": "Save as Gmail Draft", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "id": "wf-ai-email-draft-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "n8n-workflow-library"
  },
  "tags": [{ "name": "ai" }, { "name": "email" }, { "name": "openai" }]
}
