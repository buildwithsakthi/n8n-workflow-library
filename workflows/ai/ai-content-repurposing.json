{
  "name": "AI Content Repurposing Pipeline",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Content Repurposing Request",
        "formDescription": "Enter a blog post URL and we'll generate social content automatically.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Blog Post URL",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "https://yourblog.com/post-slug"
            },
            {
              "fieldLabel": "Target Audience",
              "fieldType": "text",
              "placeholder": "e.g. B2B SaaS founders, indie hackers"
            },
            {
              "fieldLabel": "Brand Voice",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Professional & Authoritative" },
                  { "option": "Casual & Conversational" },
                  { "option": "Bold & Direct" },
                  { "option": "Educational & Helpful" }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "content-repurpose-form"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json['Blog Post URL'] }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Fetch Blog Post HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Strip HTML tags to get clean text for the LLM.\n// Real senior move: limit to ~3000 chars to stay within token budget.\nconst html = $json.data || '';\nconst cleanText = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\nconst formData = $('Form Trigger').first().json;\nconst audience = formData['Target Audience'] || 'general business audience';\nconst voice = formData['Brand Voice'] || 'Professional & Authoritative';\nconst sourceUrl = formData['Blog Post URL'];\n\nconst prompt = `You are a content strategist and copywriter. Repurpose the blog post below into 3 formats.\n\nBrand Voice: ${voice}\nTarget Audience: ${audience}\n\nBlog Post Content:\n${cleanText}\n\nRespond with ONLY valid JSON:\n{\n  \"tweet\": \"<280 chars max, include 2-3 hashtags>\",\n  \"linkedin\": \"<150-200 word LinkedIn post with a hook, value, and CTA>\",\n  \"email_subject\": \"<email subject line, under 60 chars>\",\n  \"email_body\": \"<200-300 word email newsletter section>\"\n}`;\n\nreturn [{ json: { prompt, sourceUrl, audience, voice } }];"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Clean HTML & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "gpt-4o",
          "messages": [
            {
              "role": "system",
              "content": "You are a content strategist. Always respond with valid JSON only — no markdown, no explanation."
            },
            {
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ],
          "temperature": 0.8,
          "max_tokens": 1000,
          "response_format": { "type": "json_object" }
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "OpenAI - Generate Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse OpenAI response and fan out into separate items per content type.\n// Each downstream node sees one item — cleaner than nested objects.\nconst rawText = $json.choices?.[0]?.message?.content || '{}';\nlet content;\ntry {\n  content = JSON.parse(rawText);\n} catch (e) {\n  throw new Error('OpenAI returned invalid JSON: ' + rawText.slice(0, 200));\n}\n\nconst meta = $('Clean HTML & Build Prompt').first().json;\nconst now = new Date().toISOString();\n\n// Return multiple items — n8n processes each one downstream\nreturn [\n  { json: { type: 'tweet',     content: content.tweet,        sourceUrl: meta.sourceUrl, generatedAt: now } },\n  { json: { type: 'linkedin',  content: content.linkedin,     sourceUrl: meta.sourceUrl, generatedAt: now } },\n  { json: { type: 'email',     content: content.email_body,   subject: content.email_subject, sourceUrl: meta.sourceUrl, generatedAt: now } }\n];"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Split into Content Types",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Content Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Type": "={{ $json.type }}",
            "Content": "={{ $json.content }}",
            "Subject (Email Only)": "={{ $json.subject || '' }}",
            "Source URL": "={{ $json.sourceUrl }}",
            "Generated At": "={{ $json.generatedAt }}",
            "Status": "Draft"
          }
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Google Sheets - Log Content",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1250, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    }
  ],
  "connections": {
    "Form Trigger": {
      "main": [[{ "node": "Fetch Blog Post HTML", "type": "main", "index": 0 }]]
    },
    "Fetch Blog Post HTML": {
      "main": [[{ "node": "Clean HTML & Build Prompt", "type": "main", "index": 0 }]]
    },
    "Clean HTML & Build Prompt": {
      "main": [[{ "node": "OpenAI - Generate Variants", "type": "main", "index": 0 }]]
    },
    "OpenAI - Generate Variants": {
      "main": [[{ "node": "Split into Content Types", "type": "main", "index": 0 }]]
    },
    "Split into Content Types": {
      "main": [[{ "node": "Google Sheets - Log Content", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "id": "wf-ai-content-repurposing-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "n8n-workflow-library"
  },
  "tags": [{ "name": "ai" }, { "name": "content" }, { "name": "openai" }, { "name": "marketing" }]
}
